///////////////////////////////////
//2MHz调制信号
	wire	[7:0]	DAC_data_2M;

	DDS_lite DDS_lite_inst
	(
		.clk 	 	(clk_120M),
		.rst_n 		(rst_n),
		
		.dac_data 	(DAC_data_2M),
		.dac_clk 	(DAC_clk_2M)
	);

	wire	[7:0]	depth_con;
	wire	[7:0]	DAC_data_2M_2;

	assign depth_con = 77;
	assign DAC_data_2M_2 = 8'd127 + (depth_con * DAC_data_2M) >> 8;//DAC_data_2M - 8'd127;//(depth_con * DAC_data_2M) >> 8 - 1'b1;
////////////////////////////////////
//30~40MHz直达传输信号

	wire	[7:0]	DAC_data_direct_reg;

	DDS_direct DDS_direct_inst
	(
		.clk 				(clk_120M),
		.rst_n 				(rst_n),
	
		.frequency_direct 	(6'd30),
		
		.dac_data 			(DAC_data_direct_reg),
		.dac_clk 			(DAC_clk_direct)
	);

	wire	[7:0]	DAC_data_direct_wa;

	assign DAC_data_direct_wa = DAC_data_direct_reg - 8'd127;

	wire	[15:0]	DAC_data_16;

//	assign DAC_data_16 = DAC_data_2M_2 * DAC_data_direct_reg;
	multi_ip multi_ip_inst 
	(
		.dataa 	(DAC_data_2M_2),
		.datab 	(DAC_data_direct_reg),
		.result (DAC_data_16)
	);

	assign DAC_data_direct = DAC_data_16[15:8];
