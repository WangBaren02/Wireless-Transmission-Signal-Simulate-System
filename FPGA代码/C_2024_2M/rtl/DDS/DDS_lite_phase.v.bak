module DDS_lite_phase
(
	input				clk,
	input				rst_n,
	input				En,
	input				clr,

	input		[7:0]	phase,
//	input		[3:0]	parameter_modulation,
//	input		[3:0]	parameter_effective_value,
	input		[7:0]	parameter_70,

	output	reg	[7:0]	dac_data,
	output				dac_clk
);

//	wire		[35:0]	f_word;	//F_WORD=2^累加寄存器位�?*输出频率/时钟频率
	reg		[11:0]	p_word;	//P_WORD=相位/360*(2^rom地址位数)

	always@( posedge clk or negedge rst_n )
		begin
			if(!rst_n) p_word <= 12'b0;
			else p_word <= {1'b0,phase,3'b0} + {3'b0,phase,1'b0} + {4'b0,phase} + {5'b0,phase[7:1]};
		end
//////////////////////////////
	reg		[3:0]   En_r;
always @(posedge clk or negedge rst_n) begin
	if(~rst_n)
		En_r <= 3'd0;
	else
		En_r <= {En_r[2],En_r[1],En_r[0],En};
end
	reg				DDS_en;
always @(posedge clk or negedge rst_n or posedge clr) begin
	if((~rst_n)||(clr))
		DDS_en <= 1'b0;
	else if(En_r[3])
		DDS_en <= 1'b1;
	else 
		DDS_en <= DDS_en;
end
/////////////////////////////////////////	
//	wire	[7:0]	dac_data_reg;

	dds_ctrl_lite_phase	dds_ctrl_lite_phase_inst
	(
		.clk		(clk),
		.rst_n		(DDS_en),
		.f_word		(36'd1145324612),
		.p_word		(p_word),
	
		.dac_data	(dac_data_reg)
	);
//////////////////////////////
